# Generated C files (built from *.rb generator scripts)
# P.5b.5: ext/carray_math.c is now hand-written (carray_math.rb / mkmath.rb
# retired).  carray_cast_func.c and carray_kernels.c are still generated
# (by carray_cast_func.rb and mkkernel.rb respectively).  extconf.rb runs
# the generators via mtime-based hooks (see ext/extconf.rb:163-171).
ext/carray_cast_func.c
ext/carray_stat_proc.c
ext/carray_kernels.c
ext/carray_kernels_*.c
ext/carray_kernels.stamp

# Build artifacts
ext/Makefile
ext/.dev_build_mode
ext/*.bundle
ext/*.bundle.dSYM/
ext/carray_config.h
ext/mkmf.log

# Yard generated documentation (`rake yard` output).  Source-of-truth
# user documentation lives in docs/ (= hand-written .md files, tracked).
.yardoc/
doc/

